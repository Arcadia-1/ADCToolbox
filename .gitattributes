* text=auto

*.fig binary
*.mat binary
*.mdl binary diff merge=mlAutoMerge
*.mdlp binary
*.mex* binary
*.mlapp binary
*.mldatx binary merge=mlAutoMerge
*.mlproj binary
*.mlx binary
*.p binary
*.plprj binary
*.sbproj binary
*.sfx binary
*.sldd binary
*.slreqx binary merge=mlAutoMerge
*.slmx binary merge=mlAutoMerge
*.sltx binary
*.slxc binary
*.slx binary merge=mlAutoMerge
*.slxp binary

## MATLAB Project metadata files use LF line endings
/resources/project/**/*.xml text eol=lf

# Keep foreground source snapshots reproducible.
/python/src/adctoolbox/examples/12_foreground/*.py text eol=lf
/python/src/adctoolbox/calibration/foreground.py text eol=lf

## Other common binary file types
*.docx binary
*.exe binary
*.jpg binary
*.pdf binary
*.png binary
*.xlsx binary

# Preserve source hashes in Dither experiment audits.
/python/src/adctoolbox/examples/11_calibration/*.py text eol=lf
/docs/experiments/check_hdc_*.py text eol=lf
